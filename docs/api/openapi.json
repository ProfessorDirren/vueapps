  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "vue_<32 random bytes as base64url>"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "code",
              "message",
              "request_id"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "AskRequest": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3000
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "sv",
              "es",
              "hi",
              "zh-CN",
              "ru",
              "ar"
            ],
            "default": "en"
          },
          "specialist": {
            "type": "string",
            "enum": [
              "auto",
              "anyvue",
              "anivue",
              "antiqvue",
              "armvue",
              "estatevue",
              "foodvue",
              "homevue",
              "medivue",
              "motovue",
              "musicgearvue",
              "plantvue",
              "slumpvue",
              "vinylvue",
              "wardrobevue"
            ],
            "default": "auto"
          },
          "specialist_path": {
            "type": "string",
            "pattern": "^corevue(?:/[a-z][a-z0-9_-]*)+$",
            "description": "Registered path. No fixed hierarchy depth; see GET /tree."
          },
          "sub_specialist": {
            "type": "string",
            "pattern": "^[a-z_]{2,32}$",
            "description": "Optional first-refinement ID, owned by the selected lead. Prefer specialist_path for deeper branches."
          },
          "case_id": {
            "type": "string",
            "format": "uuid"
          },
          "fields": {
            "type": "object",
            "maxProperties": 20,
            "propertyNames": {
              "pattern": "^[a-zA-Z][\\w-]{0,60}$"
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 1200
            },
            "description": "Public strings only. Credentials, image/patient/private field names and obvious identifiers are rejected."
          },
          "image": {
            "type": "string",
            "pattern": "^data:image/(jpeg|png|webp);base64,",
            "maxLength": 4194304,
            "description": "Base64 data URL. Valid file signature and <=3 MiB decoded are required; remote URLs and videos are rejected."
          },
          "image_public": {
            "type": "boolean",
            "const": true,
            "description": "Required with an image. Confirms no identifiers or private patient details."
          }
        },
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "question"
            ]
          },
          {
            "required": [
              "image"
            ]
          }
        ],
        "dependentRequired": {
          "image": [
            "image_public"
          ],
          "image_public": [
            "image"
          ]
        }
      },
      "AskResponse": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "specialist": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "anyvue",
              "anivue",
              "antiqvue",
              "armvue",
              "estatevue",
              "foodvue",
              "homevue",
              "medivue",
              "motovue",
              "musicgearvue",
              "plantvue",
              "slumpvue",
              "vinylvue",
              "wardrobevue",
              null
            ]
          },
          "sub_specialist": {
            "type": [
              "string",
              "null"
            ]
          },
          "specialist_path": {
            "type": "string",
            "pattern": "^corevue(?:/[a-z][a-z0-9_-]*)+$",
            "description": "Registered path. No fixed hierarchy depth; see GET /tree."
          },
          "lineage": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "image_analyzed": {
            "type": "boolean"
          },
          "case_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "answer": {
            "type": "string",
            "maxLength": 8000
          },
          "kind": {
            "type": "string",
            "enum": [
              "ai_unverified",
              "local_guidance",
              "safety_rule",
              "clarification"
            ]
          },
          "verified": {
            "type": "boolean",
            "const": false
          },
          "requires_verification": {
            "type": "boolean",
            "const": true
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "anyvue",
                "anivue",
                "antiqvue",
