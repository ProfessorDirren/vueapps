{
  "openapi": "3.1.0",
  "info": {
    "title": "CORE-VUE HTTPS API",
    "version": "1.0.0",
    "description": "VUE — The Portal of Knowledge. Photo first, then CORE routes through progressively specialised registered branches. Server-to-server Bearer credentials, tenant/subject isolation, explicit cases, atomic quotas and 24-hour idempotency. No verified valuation or personal medical diagnosis. Missing credential configuration fails closed."
  },
